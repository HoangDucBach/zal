{
  "name": "@zal/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "ponder dev",
    "start": "node lib/app-db/migrate.ts && ponder start",
    "codegen": "ponder codegen",
    "gen:abis": "node scripts/gen-abis.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stack": "node test/stack/demo.ts && node test/stack/explorer.ts",
    "test:reindex": "cd ../.. && packages/indexer/test/stack/reindex-diff.sh",
    "db:migrate": "node lib/app-db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.5",
    "drizzle-orm": "0.41.0",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "ponder": "0.18.7",
    "viem": "2.57.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.13",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.5"
  }
}
