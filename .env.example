# Copy to .env to change the local stack's host ports or the Postgres password. Every value is local-only.
POSTGRES_PASSWORD=zal-local-only
ZAL_POSTGRES_PORT=5433
ZAL_ANVIL_PORT=8545
ZAL_INDEXER_PORT=42069
ZAL_KEEPER_PORT=42070
ZAL_WEB_PORT=3100
# Web origins allowed to sign in, comma-separated, exact (no wildcard). Add yours if web runs on another port.
ZAL_WEB_ORIGIN=http://localhost:3100,http://localhost:3001
